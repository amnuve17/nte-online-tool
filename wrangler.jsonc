{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-the-end-token-bag-party",
  "main": "party/room.js",
  "compatibility_date": "2024-09-23",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "routes": [
    { "pattern": "not-the-end-token-bag.party", "custom_domain": true }
  ]
}
